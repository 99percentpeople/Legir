{
  "name": "legir-pdf-reader",
  "private": true,
  "version": "0.2.0",
  "license": "AGPL-3.0-or-later",
  "author": "Zach Yuen <yuenzach99@gmail.com>",
  "repository": "https://github.com/99percentpeople/Legir",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/services/pdfService/assets.ts",
    "./src/services/pdfService/host.ts"
  ],
  "displayName": "Legir",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "www"
  ],
  "scripts": {
    "update:ai-catalog": "bun scripts/update-models-dev.ts",
    "dev": "bun run build:packages && vite",
    "dev:www": "bun run --cwd www dev",
    "dev:app": "tauri dev",
    "build": "bun run build:packages && tsc --noEmit && vite build",
    "build:www": "bun run --cwd www build",
    "build:turbo": "turbo run build",
    "build:app": "tauri build",
    "build:web:tauri": "bun run build:packages && tsc --noEmit && vite build --mode tauri",
    "check:desktop": "bun scripts/desktop-release.ts check",
    "icons:generate": "bun scripts/generate-icons.ts",
    "icons:generate:app": "bun scripts/generate-icons.ts app",
    "icons:generate:pdf": "bun scripts/generate-icons.ts pdf",
    "preview": "bun run build:turbo && vite preview",
    "preview:www": "bun run --cwd www preview",
    "test": "bun run build:packages && bun run check:boundaries && vitest run",
    "test:watch": "bun run build:packages && vitest",
    "format": "prettier --write \"./{src,www,tests,config,packages/*/src,packages/*/tests}/**/*.{js,jsx,ts,tsx,css,html,json,md}\" \"./*.config.{js,ts}\"",
    "typecheck": "bun run build:packages && tsc --noEmit",
    "typecheck:www": "tsc --noEmit -p www/tsconfig.json",
    "lint": "bun run check:boundaries && eslint . && bun run typecheck && bun run typecheck:www",
    "lint:eslint": "eslint .",
    "prepare": "husky",
    "build:pdfium": "bun run --cwd packages/pdfium build",
    "build:native:pdfium": "bun run --cwd packages/pdfium build:native",
    "test:pdfium": "bun run --cwd packages/pdfium test",
    "build:packages": "bun run build:pdfium && bun run --cwd packages/pdf-model build && bun run --cwd packages/pdf-core build && bun run --cwd packages/pdf-renderer build",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "test:consumer": "bun run build:packages && node scripts/check-package-consumer.mjs"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,html,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.117",
    "@ai-sdk/groq": "^4.0.81",
    "@ai-sdk/openai": "^4.0.114",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@ai-sdk/provider": "4.0.37",
    "@ai-sdk/provider-utils": "5.0.79",
    "@ai-sdk/xai": "^5.0.43",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@internationalized/date": "3.12.4",
    "@legir/pdfium": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/plugin-cli": "~2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.3",
    "ai": "^7.0.169",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "dompurify": "3.4.17",
    "emblor": "^1.4.8",
    "lucide-react": "1.71.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "next-themes": "^0.4.6",
    "pdf-fontkit": "^1.8.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.5",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "wouter": "^3.13.0",
    "zhipu-ai-provider": "^0.4.0",
    "zod": "^4.6.7",
    "zustand": "5.1.0",
    "@legir/pdf-model": "workspace:*",
    "@legir/pdf-core": "workspace:*",
    "@legir/pdf-renderer": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.23.0",
    "turbo": "^2.11.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
