{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile --filter './'",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/ignore-web-build.mjs",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
