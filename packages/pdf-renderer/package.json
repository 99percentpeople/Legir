{
  "name": "@legir/pdf-renderer",
  "version": "0.2.1",
  "description": "Host-injected PDF worker client and browser rendering runtime",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/99percentpeople/Legir.git",
    "directory": "packages/pdf-renderer"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/worker.js",
    "./dist/content-worker.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./content-worker": {
      "types": "./dist/content-worker.d.ts",
      "import": "./dist/content-worker.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@legir/pdf-model": "workspace:*",
    "@legir/pdf-core": "workspace:*",
    "@legir/pdfium": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^26.6.6"
  }
}
