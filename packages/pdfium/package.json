{
  "name": "@legir/pdfium",
  "version": "0.2.1",
  "description": "Standalone PDFium WebAssembly engine and TypeScript bindings",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/99percentpeople/Legir.git",
    "directory": "packages/pdfium"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "wasm",
    "src",
    "native",
    "scripts/*.py",
    "scripts/*.mjs",
    "tsconfig.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm/*": "./wasm/*",
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "import": "./dist/authoring/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/verify-artifacts.mjs && tsc -p tsconfig.json",
    "build:native": "python3 scripts/build.py",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fast-png": "^8.0.0"
  }
}
