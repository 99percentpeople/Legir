{
  "name": "@legir/pdf-model",
  "version": "0.1.0",
  "description": "Portable PDF document models, geometry and editing policies",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.12.4"
  }
}
